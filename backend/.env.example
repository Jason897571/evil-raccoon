# 复制成 .env 后按需修改；不建 .env 就用 app/config.py 里的默认值

# dev：验证码打印到日志并显示在登录页，订单页有「模拟支付」；上线改成 prod
APP_ENV=dev
# 上线前务必换成一串随机字符（验证码和登录 token 的哈希都靠它）
SECRET_KEY=dev-secret-change-me

DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/evil_raccoon?charset=utf8mb4
# pixel-skill 的发布目录，导入脚本从这里读封面、GIF 和压缩包
RELEASE_DIR=/path/to/pixel-skill/release

# 上线走 HTTPS 时设为 true
COOKIE_SECURE=false

# 发验证码的邮箱（SMTP over SSL）；不填就只打印到后端日志
# 例：QQ 邮箱 smtp.qq.com:465，密码填「授权码」
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 网站对外地址（支付宝付完跳回来用）
SITE_URL=http://localhost:5180

# 支付宝电脑网站支付；不配的话开发环境用模拟支付，正式环境显示「在线支付暂未开放」
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=          # 应用私钥，PEM 或密钥工具导出的裸 base64 都行
ALIPAY_PUBLIC_KEY=           # 支付宝公钥（不是应用公钥）
ALIPAY_NOTIFY_URL=           # 公网可达，例如 https://www.evilraccoon.top/api/payments/alipay/notify
ALIPAY_SANDBOX=false
